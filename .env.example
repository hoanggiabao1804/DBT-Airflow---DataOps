# Copy the relevant section to .env.dev, .env.staging, or .env.prod.
# Replace every CHANGE_ME value before using the copied file.
# The real .env.* files are ignored by Git; commit only this template.
# deploy.sh takes the environment and dbt target as command arguments.

# Development (.env.dev)
DBT_TARGET=dev
AIRFLOW_ENV=development
SQL_SERVER=localhost
SQL_USER=sa
SQL_PASSWORD=CHANGE_ME

# Optional Docker Compose settings for local development.
# The current dbt dev profile uses its own fixed SQL credentials; update it
# together with SQLSERVER_SA_PASSWORD if you change the local SA password.
# AIRFLOW_UID=1000
# SQLSERVER_SA_PASSWORD=CHANGE_ME

# Staging (.env.staging)
# DBT_TARGET=staging
# AIRFLOW_ENV=staging
# STAGING_SQL_SERVER=staging-server.example.com
# STAGING_SQL_DATABASE=AdventureWorks2014_Staging
# STAGING_SQL_USER=CHANGE_ME
# STAGING_SQL_PASSWORD=CHANGE_ME

# Production (.env.prod)
# DBT_TARGET=prod
# AIRFLOW_ENV=production
# PROD_SQL_SERVER=prod-server.example.com
# PROD_SQL_USER=CHANGE_ME
# PROD_SQL_PASSWORD=CHANGE_ME

# The GitHub Actions staging job creates its own temporary SQL Server and
# credentials. It does not read .env.staging from this repository.
